  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"color\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"archived_at\" TEXT NULL, \"deleted_at\" TEXT NULL, \"last_used_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"color\" TEXT NULL, \"type\" TEXT NOT NULL DEFAULT 'general', \"source_lang\" TEXT NULL, \"target_lang\" TEXT NULL, \"deleted_at\" TEXT NULL, \"last_used_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cards\" (\"id\" TEXT NOT NULL, \"deck_id\" TEXT NOT NULL REFERENCES decks (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"question\" TEXT NOT NULL, \"question_image\" TEXT NULL, \"answer\" TEXT NULL, \"answer_image\" TEXT NULL, \"explanation\" TEXT NULL, \"allow_multiple\" INTEGER NOT NULL DEFAULT 0 CHECK (\"allow_multiple\" IN (0, 1)), \"example\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "card_options",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_options\" (\"id\" TEXT NOT NULL, \"card_id\" TEXT NOT NULL REFERENCES cards (id) ON DELETE CASCADE, \"text\" TEXT NOT NULL, \"is_correct\" INTEGER NOT NULL CHECK (\"is_correct\" IN (0, 1)), \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "card_stats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_stats\" (\"card_id\" TEXT NOT NULL REFERENCES cards (id) ON DELETE CASCADE, \"direction\" TEXT NOT NULL, \"correct_count\" INTEGER NOT NULL DEFAULT 0, \"wrong_count\" INTEGER NOT NULL DEFAULT 0, \"consecutive_correct\" INTEGER NOT NULL DEFAULT 0, \"in_error_list\" INTEGER NOT NULL DEFAULT 0 CHECK (\"in_error_list\" IN (0, 1)), \"last_result\" TEXT NULL, \"last_attempt_at\" TEXT NULL, PRIMARY KEY (\"card_id\", \"direction\"));"
        }
      ]
    },
    {
      "name": "study_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"study_sessions\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"mode\" TEXT NOT NULL, \"direction\" TEXT NOT NULL, \"requested_count\" INTEGER NULL, \"prioritize_failed\" INTEGER NOT NULL CHECK (\"prioritize_failed\" IN (0, 1)), \"repeat_failed\" INTEGER NOT NULL CHECK (\"repeat_failed\" IN (0, 1)), \"timer_type\" TEXT NOT NULL, \"timer_seconds\" INTEGER NULL, \"status\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"ended_at\" TEXT NULL, \"active_duration_ms\" INTEGER NOT NULL DEFAULT 0, \"correct_total\" INTEGER NOT NULL DEFAULT 0, \"wrong_total\" INTEGER NOT NULL DEFAULT 0, \"unanswered_total\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "session_decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"session_decks\" (\"session_id\" TEXT NOT NULL REFERENCES study_sessions (id) ON DELETE CASCADE, \"deck_id\" TEXT NOT NULL REFERENCES decks (id) ON DELETE CASCADE, PRIMARY KEY (\"session_id\", \"deck_id\"));"
        }
      ]
    },
    {
      "name": "attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attempts\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES study_sessions (id) ON DELETE CASCADE, \"card_id\" TEXT NOT NULL REFERENCES cards (id) ON DELETE CASCADE, \"direction\" TEXT NOT NULL, \"result\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"is_first_attempt\" INTEGER NOT NULL CHECK (\"is_first_attempt\" IN (0, 1)), \"selected_option_ids\" TEXT NULL, \"response_time_ms\" INTEGER NULL, \"answered_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NULL, PRIMARY KEY (\"key\"));"
