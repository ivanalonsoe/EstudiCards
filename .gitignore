# --- EstudiCards ---
# Code generated by build_runner (Drift, Riverpod) is not committed: run
# `dart run build_runner build --delete-conflicting-outputs` after cloning
# or pulling. CI generates it too.
*.g.dart
# UI string classes generated from the ARB files by `flutter gen-l10n`
# (also run by `flutter pub get`).
/lib/app/l10n/generated/
# Generated by `patrol test` to bundle every E2E test into one app.
/patrol_test/test_bundle.dart